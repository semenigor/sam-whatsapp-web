{
  "name": "sam-whatsapp-web",
  "version": "0.4.0",
  "description": "Linux Electron wrapper for WhatsApp Web",
  "main": "main.js",
  "private": true,
  "author": "SAM",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:dir": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac:dir": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux:deb": "electron-builder --linux deb --x64 --publish never"
  },
  "build": {
    "appId": "com.semenigor.samwhatsappweb",
    "productName": "SAM WhatsApp Web",
    "files": [
      "main.js",
      "assets/**/*",
      "package.json",
      "preview.html",
      "preview_preload.js",
      "wa_preload.js",
      "settings.html",
      "settings_preload.js"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icons",
      "executableName": "sam-whatsapp-web",
      "synopsis": "WhatsApp Web Linux wrapper",
      "description": "Electron wrapper for WhatsApp Web on Linux",
      "artifactName": "SAM-WhatsApp-Web-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "SAM WhatsApp Web",
          "Comment": "WhatsApp Web wrapper with SAM tools",
          "Categories": "Network;InstantMessaging;",
          "StartupWMClass": "SAM WhatsApp Web",
          "Terminal": "false"
        }
      },
      "maintainer": "SAM WhatsApp Web Maintainers <semenigor@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "SAM-WhatsApp-Web-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "semenigor",
        "repo": "sam-whatsapp-web"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SAM-WhatsApp-Web-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "helpers/sam_encrypt",
        "to": "helpers/sam_encrypt",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.bak*",
          "!build/**",
          "!dist/**",
          "!*.spec"
        ]
      }
    ],
    "deb": {
      "packageName": "sam-whatsapp-web",
      "artifactName": "SAM-WhatsApp-Web-${version}-${arch}.deb",
      "packageCategory": "net",
      "priority": "optional",
      "afterInstall": "build/linux/deb-after-install.sh",
      "afterRemove": "build/linux/deb-after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "libappindicator3-1"
      ]
    }
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "24.13.3"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
